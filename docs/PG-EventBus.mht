<span style=3D'mso-spacerun:yes'>    </span>v_target DATE;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_part_name TEXT;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_exists
BOOLEAN;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>FOR v_i IN 0..p_months_ahead=
 LOOP</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>v_target =
:=3D
(v_base_date + (v_i || ' months')::interval)::DATE;<br>
<span style=3D'mso-spacerun:yes'>        </span>v_part_name :=3D 'ev=
ent_log_' ||
to_char(v_target, 'YYYYMM');</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>--
快速存在性检查<br>
<span style=3D'mso-spacerun:yes'>        </span>SELECT EXISTS (<br>
<span style=3D'mso-spacerun:yes'>            </span>SELECT 1<br>
<span style=3D'mso-spacerun:yes'>            </span>FROM pg_clas=
s c<br>
<span style=3D'mso-spacerun:yes'>            </span>JOIN pg_name=
space n ON n.oid
=3D c.relnamespace<br>
<span style=3D'mso-spacerun:yes'>            </span>WHERE c.reln=
ame =3D
v_part_name<br>
<span style=3D'mso-spacerun:yes'>              </span>AND n.ns=
pname =3D 'bus'<br>
<span style=3D'mso-spacerun:yes'>        </span>)<br>
<span style=3D'mso-spacerun:yes'>        </span>INTO v_exists;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>IF NOT v_=
exists
THEN</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>-- adviso=
ry
lock 防并发<br>
<span style=3D'mso-spacerun:yes'>            </span>PERFORM
pg_advisory_lock(hashtext(v_part_name));</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>--
double-check<br>
<span style=3D'mso-spacerun:yes'>            </span>SELECT EXIST=
S (<br>
<span style=3D'mso-spacerun:yes'>                </span>SELE=
CT 1<br>
<span style=3D'mso-spacerun:yes'>                </span>FROM=
 pg_class c<br>
<span style=3D'mso-spacerun:yes'>                </span>JOIN=
 pg_namespace n ON
n.oid =3D c.relnamespace<br>
<span style=3D'mso-spacerun:yes'>                </span>WHER=
E c.relname =3D
v_part_name<br>
<span style=3D'mso-spacerun:yes'>                  </span>=
AND n.nspname =3D
'bus'<br>
<span style=3D'mso-spacerun:yes'>            </span>)<br>
<span style=3D'mso-spacerun:yes'>            </span>INTO v_exist=
s;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>IF NOT v_=
exists
THEN<br>
