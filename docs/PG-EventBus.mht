AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_base DATE :=3D date_trunc(=
'month',
now())::DATE;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_i INT;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_target DATE;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>FOR v_i IN 0..p_months_ahead
LOOP<br>
<span style=3D'mso-spacerun:yes'>        </span>v_target :=3D (v_bas=
e + (v_i || '
months')::interval)::DATE;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>PERFORM
bus.create_month_partition(<br>
<span style=3D'mso-spacerun:yes'>            </span>EXTRACT(YEAR=
 FROM
v_target)::INT,<br>
<span style=3D'mso-spacerun:yes'>            </span>EXTRACT(MONT=
H FROM
v_target)::INT<br>
<span style=3D'mso-spacerun:yes'>        </span>);<br>
<span style=3D'mso-spacerun:yes'>    </span>END LOOP;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>新函数：预创建未来 N 个月</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>CREATE OR
REPLACE FUNCTION bus.ensure_future_partitions(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_months_ahead INT DEFAULT 6=
<br>
) RETURNS VOID<br>
LANGUAGE plpgsql</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>SECURITY
DEFINER<br>
SET search_path =3D bus, pg_catalog</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>AS
$$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_base_date DATE :=3D
