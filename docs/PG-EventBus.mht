<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>CREATE OR
REPLACE FUNCTION bus.drop_partition_older_than(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_keep_months INT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
SET search_path =3D bus, pg_catalog<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_cutoff DATE;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_part RECORD;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>v_cutoff :=3D date_trunc('mo=
nth',
now()) - (p_keep_months || ' months')::interval;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>FOR v_part
IN<br>
<span style=3D'mso-spacerun:yes'>        </span>SELECT inhrelid::reg=
class AS
partition_name<br>
<span style=3D'mso-spacerun:yes'>        </span>FROM pg_inherits<br>
<span style=3D'mso-spacerun:yes'>        </span>JOIN pg_class parent=
 ON pg_inherits.inhparent
=3D parent.oid<br>
<span style=3D'mso-spacerun:yes'>        </span>WHERE parent.relname=
 =3D
'event_log'<br>
<span style=3D'mso-spacerun:yes'>          </span>AND parent.relna=
mespace =3D
'bus'::regnamespace<br>
<span style=3D'mso-spacerun:yes'>    </span>LOOP<br>
<span style=3D'mso-spacerun:yes'>        </span>IF v_part.partition_=
name::TEXT
&lt; 'bus.event_log_' || to_char(v_cutoff, 'YYYYMM') THEN<br>
<span style=3D'mso-spacerun:yes'>            </span>EXECUTE form=
at('DROP TABLE IF
EXISTS %s CASCADE', v_part.partition_name);<br>
<span style=3D'mso-spacerun:yes'>        </span>END IF;<br>
<span style=3D'mso-spacerun:yes'>    </span>END LOOP;<br>
END;<br>
$$;</p>

