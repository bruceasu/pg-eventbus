<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>3.1 单月分区创建函数</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>CREATE OR
REPLACE FUNCTION bus.create_month_partition(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_year INT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_month INT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
SET search_path =3D bus, pg_catalog<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_start TIMESTAMPTZ;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_end<span
style=3D'mso-spacerun:yes'>   </span>TIMESTAMPTZ;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_name<span
style=3D'mso-spacerun:yes'>  </span>TEXT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>v_start :=3D make_timestampt=
z(p_year,
p_month, 1, 0, 0, 0);<br>
<span style=3D'mso-spacerun:yes'>    </span>v_end<span
style=3D'mso-spacerun:yes'>   </span>:=3D v_start + interval '1 month';<b=
r>
<span style=3D'mso-spacerun:yes'>    </span>v_name<span
style=3D'mso-spacerun:yes'>  </span>:=3D format('event_log_%s', to_char(v_=
start,
'YYYYMM'));</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>EXECUTE
format(<br>
<span style=3D'mso-spacerun:yes'>        </span>'CREATE TABLE IF NOT=
 EXISTS
bus.%I<br>
<span style=3D'mso-spacerun:yes'>         </span>PARTITION OF
bus.event_log<br>
<span style=3D'mso-spacerun:yes'>         </span>FOR VALUES FROM (%=
L) TO
(%L)',<br>
<span style=3D'mso-spacerun:yes'>         </span>v_name, v_start,
v_end<br>
<span style=3D'mso-spacerun:yes'>    </span>);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>EXECUTE
format(<br>
<span style=3D'mso-spacerun:yes'>        </span>'CREATE INDEX IF NOT=
 EXISTS
%I_target_id<br>
<span style=3D'mso-spacerun:yes'>         </span>ON bus.%I (target_=
system,
id)',<br>
<span style=3D'mso-spacerun:yes'>         </span>v_name, v_name<br>
<span style=3D'mso-spacerun:yes'>    </span>);<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>自动确保当前分区存在 ensure_current_pa=
rtition</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>CREATE OR
REPLACE FUNCTION bus.ensure_current_partition()<br>
RETURNS VOID<br>
LANGUAGE plpgsql<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_now TIMESTAMPTZ :=3D
date_trunc('month', now());<br>
<span style=3D'mso-spacerun:yes'>    </span>v_part_name TEXT :=3D 'event=
_log_' ||
to_char(v_now, 'YYYYMM');<br>
<span style=3D'mso-spacerun:yes'>    </span>v_exists
BOOLEAN;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>-- 1. 快速存在性检查<=
br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT EXISTS (<br>
<span style=3D'mso-spacerun:yes'>        </span>SELECT 1<br>
<span style=3D'mso-spacerun:yes'>        </span>FROM pg_class c<br>
<span style=3D'mso-spacerun:yes'>        </span>JOIN pg_namespace n =
ON n.oid =3D
c.relnamespace<br>
<span style=3D'mso-spacerun:yes'>        </span>WHERE c.relname =3D
v_part_name<br>
<span style=3D'mso-spacerun:yes'>          </span>AND n.nspname =3D
'bus'<br>
<span style=3D'mso-spacerun:yes'>    </span>)<br>
<span style=3D'mso-spacerun:yes'>    </span>INTO v_exists;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>IF v_exis=
ts
THEN<br>
<span style=3D'mso-spacerun:yes'>        </span>RETURN;<br>
<span style=3D'mso-spacerun:yes'>    </span>END IF;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>-- 2. 使=
用
advisory lock 防止并发创建<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
pg_advisory_lock(hashtext(v_part_name));</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>--
再检查一次（double-check）<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT EXISTS (<br>
<span style=3D'mso-spacerun:yes'>        </span>SELECT 1<br>
<span style=3D'mso-spacerun:yes'>        </span>FROM pg_class c<br>
<span style=3D'mso-spacerun:yes'>        </span>JOIN pg_namespace n =
ON n.oid =3D
c.relnamespace<br>
<span style=3D'mso-spacerun:yes'>        </span>WHERE c.relname =3D
v_part_name<br>
<span style=3D'mso-spacerun:yes'>          </span>AND n.nspname =3D
'bus'<br>
<span style=3D'mso-spacerun:yes'>    </span>)<br>
<span style=3D'mso-spacerun:yes'>    </span>INTO v_exists;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>IF NOT v_=
exists
THEN<br>
<span style=3D'mso-spacerun:yes'>        </span>PERFORM
bus.create_month_partition(<br>
<span style=3D'mso-spacerun:yes'>            </span>EXTRACT(YEAR=
 FROM
v_now)::INT,<br>
<span style=3D'mso-spacerun:yes'>            </span>EXTRACT(MONT=
H FROM
v_now)::INT<br>
<span style=3D'mso-spacerun:yes'>        </span>);<br>
<span style=3D'mso-spacerun:yes'>    </span>END IF;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>PERFORM
pg_advisory_unlock(hashtext(v_part_name));<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>3.2 预创建未来 N 个月</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>CREATE OR
