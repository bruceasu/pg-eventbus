3in'>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'><span
lang=3Dzh-CN>说明：你可以把它们放在一个 SQL 文件里执行。=
默认 schema 叫 </span><span lang=3Den-US>bus</span><span
lang=3Dzh-CN>（bus=3Devent bus）。</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.1 Schema + 表 + 索引</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
SCHEMA IF NOT EXISTS bus;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>--
事件日志（单表）<br>
CREATE TABLE IF NOT EXISTS bus.event_log (<br>
<span style=3D'mso-spacerun:yes'>    </span>id<span
style=3D'mso-spacerun:yes'>              </span>BIGSERIAL PRIM=
ARY KEY,<br>
<span style=3D'mso-spacerun:yes'>    </span>source_system<span
style=3D'mso-spacerun:yes'>   </span>TEXT NOT NULL,<br>
<span style=3D'mso-spacerun:yes'>    </span>target_system<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<span
style=3D'mso-spacerun:yes'>                      </spa=
n>-- NULL =3D 广播<br>
<span style=3D'mso-spacerun:yes'>    </span>event_type<span
style=3D'mso-spacerun:yes'>      </span>TEXT NOT NULL,<br>
<span style=3D'mso-spacerun:yes'>    </span>payload<span
style=3D'mso-spacerun:yes'>         </span>JSONB NOT NULL,<br>
<span style=3D'mso-spacerun:yes'>    </span>created_at<span
style=3D'mso-spacerun:yes'>      </span>TIMESTAMPTZ NOT NULL DEFAULT
now()<br>
);<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
INDEX IF NOT EXISTS idx_event_target_id<br>
<span style=3D'mso-spacerun:yes'>    </span>ON bus.event_log(target_syst=
em, id);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
INDEX IF NOT EXISTS idx_event_created<br>
<span style=3D'mso-spacerun:yes'>    </span>ON bus.event_log(created_at)=
;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>--
消费者注册表（offset + 分布式单线程锁）<br>
CREATE TABLE IF NOT EXISTS bus.consumer_registry (<br>
<span style=3D'mso-spacerun:yes'>    </span>consumer_name<span
style=3D'mso-spacerun:yes'>   </span>TEXT PRIMARY KEY,<br>
<span style=3D'mso-spacerun:yes'>    </span>last_event_id<span
style=3D'mso-spacerun:yes'>   </span>BIGINT NOT NULL DEFAULT 0,<br>
<span style=3D'mso-spacerun:yes'>    </span>registered_at<span
style=3D'mso-spacerun:yes'>   </span>TIMESTAMPTZ NOT NULL DEFAULT
now(),<br>
<span style=3D'mso-spacerun:yes'>    </span>updated_at<span
style=3D'mso-spacerun:yes'>      </span>TIMESTAMPTZ NOT NULL DEFAULT
now(),<br>
<span style=3D'mso-spacerun:yes'>    </span>lock_owner<span
style=3D'mso-spacerun:yes'>      </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>lock_until<span
style=3D'mso-spacerun:yes'>      </span>TIMESTAMPTZ<br>
);<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
INDEX IF NOT EXISTS idx_consumer_lock_until<br>
<span style=3D'mso-spacerun:yes'>    </span>ON bus.consumer_registry(loc=
k_until);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.2 发布事件：bus.publish_event</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.publish_event(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_source_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_target_system TEXT,<span
style=3D'mso-spacerun:yes'>          </span>-- NULL =3D 广播<br>
<span style=3D'mso-spacerun:yes'>    </span>p_event_type<span
style=3D'mso-spacerun:yes'>    </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_payload<span
style=3D'mso-spacerun:yes'>       </span>JSONB<br>
) RETURNS BIGINT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_id BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>INSERT INTO
bus.event_log(source_system, target_system, event_type, payload)<br>
<span style=3D'mso-spacerun:yes'>    </span>VALUES (p_source_system,
p_target_system, p_event_type, p_payload)<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURNING id INTO v_id;<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
v_id;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.3 消费者注册：bus.register_consumer</spa=
n></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.register_consumer(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>INSERT INTO
bus.consumer_registry(consumer_name)<br>
<span style=3D'mso-spacerun:yes'>    </span>VALUES (p_consumer_name)<br>
<span style=3D'mso-spacerun:yes'>    </span>ON CONFLICT (consumer_name) =
DO
NOTHING;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.4 从指定时间点初始化 offset：bus.ini=
t_consumer_at_time</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>如果你担心历=
史数据很多，用这个函数一次性把
     offset 设到某个时间点对应的最大 id。</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.init_consumer_at_time(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_start_time<span
style=3D'mso-spacerun:yes'>    </span>TIMESTAMPTZ<br>
) RETURNS BIGINT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_id BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>SELECT
COALESCE(MAX(id), 0)<br>
<span style=3D'mso-spacerun:yes'>      </span>INTO v_id<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE created_at &lt;=3D p=
_start_time;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET last_event_id =3D
v_id,<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D p_=
consumer_name;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
v_id;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'><span
lang=3Dzh-CN>（你也可以做一个 </span><span lang=3Den-US>init_consum=
er_at_latest()</span><span
lang=3Dzh-CN>，逻辑就是取全表 MAX(id)。）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.5 获取单消费者锁：bus.acquire_consumer=
_lock</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>用 TTL 锁避免�=
��死锁永久占用”</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>p_instance_id 由�=
��用生成（比如
     hostname+pid 或 UUID）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>返回 boolean 表=
示是否获取成功</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.acquire_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_ttl_seconds<span
style=3D'mso-spacerun:yes'>   </span>INT DEFAULT 30<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_owner =3D
p_instance_id,<br>
<span style=3D'mso-spacerun:yes'>           </span>lock_until =3D=
 now() +
make_interval(secs =3D&gt; p_ttl_seconds),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND (lock_until IS NUL=
L OR
lock_until &lt; now());</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>实务建议：消费循环中可以“续租”锁（再次调用 =
acquire，或做一个 renew_lock）。</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>这里最简：每次 poll 前都先 acquire（锁没过期就拿�=
�到，需续租时用 renew）。</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.6 续租锁：bus.renew_consumer_lock（可选=
但很实用）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.renew_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_ttl_seconds<span
style=3D'mso-spacerun:yes'>   </span>INT DEFAULT 30<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_until =3D now=
() +
make_interval(secs =3D&gt; p_ttl_seconds),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D
p_instance_id<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_until &gt;=3D=
 now();</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.7 拉取事件：bus.poll_events</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>返回一批事件=
（表返回）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt' lang=3Dzh-CN>注�=
�：这里不做“认领/锁定事件行”，因为你是
     offset 模型；</span><span style=3D'font-weight:bold;font-family:asu=
-cjk-code;
     font-size:11.0pt' lang=3Den-US>单线程锁</span><span style=3D'font-=
family:asu-cjk-code;
     font-size:11.0pt' lang=3Dzh-CN>确保同一 consumer 不并发消费�=
�从而避免重复。</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.poll_events(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_limit<span
style=3D'mso-spacerun:yes'>         </span>INT DEFAULT 100<br>
) RETURNS TABLE(<br>
<span style=3D'mso-spacerun:yes'>    </span>id BIGINT,<br>
<span style=3D'mso-spacerun:yes'>    </span>source_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>target_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>event_type TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>payload JSONB,<br>
<span style=3D'mso-spacerun:yes'>    </span>created_at
TIMESTAMPTZ<br>
)<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_last BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>SELECT
last_event_id INTO v_last<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
QUERY<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT e.id, e.source_system,
e.target_system, e.event_type, e.payload, e.created_at<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM bus.event_log e<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE e.id &gt; v_last<br>
<span style=3D'mso-spacerun:yes'>       </span>AND (e.target_system =
=3D
p_consumer_name OR e.target_system IS NULL)<br>
<span style=3D'mso-spacerun:yes'>     </span>ORDER BY e.id<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_limit;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.8 提交 offset：bus.commit_consumer_offset</=
span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>只允许前进（=
防止回退）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>可附带锁校验=
（建议），避免“不是锁持有者也能提交
