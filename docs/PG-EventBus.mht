<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>publish_event（支持自动建分区）</span><=
/p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.publish_event(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_source_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_target_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_event_type<span
style=3D'mso-spacerun:yes'>    </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_payload<span
style=3D'mso-spacerun:yes'>       </span>JSONB<br>
) RETURNS BIGINT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_id BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>-- PERFORM
bus.ensure_current_partition();</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US><span
style=3D'mso-spacerun:yes'>    </span>INSERT INTO bus.event_log(source_s=
ystem,
target_system, event_type, payload)<br>
<span style=3D'mso-spacerun:yes'>    </span>VALUES (p_source_system,
p_target_system, p_event_type, p_payload)<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURNING id INTO v_id;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
v_id;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>消费者注册：bus.register_consumer</span></=
p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.register_consumer(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>INSERT INTO
bus.consumer_registry(consumer_name)<br>
<span style=3D'mso-spacerun:yes'>    </span>VALUES (p_consumer_name)<br>
<span style=3D'mso-spacerun:yes'>    </span>ON CONFLICT (consumer_name) =
DO
NOTHING;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>从指定时间点初始化 offset：bus.init_co=
nsumer_at_time</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>如果你担心历=
史数据很多，用这个函数一次性把
     offset 设到某个时间点对应的最大 id。</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.init_consumer_at_time(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_start_time<span
style=3D'mso-spacerun:yes'>    </span>TIMESTAMPTZ<br>
) RETURNS BIGINT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_id BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>SELECT
COALESCE(MAX(id), 0)<br>
<span style=3D'mso-spacerun:yes'>      </span>INTO v_id<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE created_at &lt;=3D p=
_start_time;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET last_event_id =3D
v_id,<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D p_=
consumer_name;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
v_id;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'><span
lang=3Dzh-CN>（你也可以做一个 </span><span lang=3Den-US>init_consum=
er_at_latest()</span><span
lang=3Dzh-CN>，逻辑就是取全表 MAX(id)。）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>获取单消费者锁：bus.acquire_consumer_loc=
k</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>用 TTL 锁避免�=
��死锁永久占用”</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>p_instance_id 由�=
��用生成（比如
     hostname+pid 或 UUID）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>返回 boolean 表=
示是否获取成功</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.acquire_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_ttl_seconds<span
style=3D'mso-spacerun:yes'>   </span>INT DEFAULT 30<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_owner =3D
p_instance_id,<br>
<span style=3D'mso-spacerun:yes'>           </span>lock_until =3D=
 now() +
make_interval(secs =3D&gt; p_ttl_seconds),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND (lock_until IS NUL=
L OR
lock_until &lt; now());</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>实务建议：消费循环中可以“续租”锁（再次调用 =
acquire，或做一个 renew_lock）。</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>这里最简：每次 poll 前都先 acquire（锁没过期就拿�=
�到，需续租时用 renew）。</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>续租锁：bus.renew_consumer_lock（可选但�=
��实用）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.renew_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_ttl_seconds<span
style=3D'mso-spacerun:yes'>   </span>INT DEFAULT 30<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_until =3D now=
() +
make_interval(secs =3D&gt; p_ttl_seconds),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D
p_instance_id<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_until &gt;=3D=
 now();</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>拉取事件：bus.poll_events</span></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>返回一批事件=
（表返回）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt' lang=3Dzh-CN>注�=
�：这里不做“认领/锁定事件行”，因为你是
     offset 模型；</span><span style=3D'font-weight:bold;font-family:asu=
-cjk-code;
     font-size:11.0pt' lang=3Den-US>单线程锁</span><span style=3D'font-=
family:asu-cjk-code;
     font-size:11.0pt' lang=3Dzh-CN>确保同一 consumer 不并发消费�=
�从而避免重复。</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.poll_events(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_limit<span
style=3D'mso-spacerun:yes'>         </span>INT DEFAULT 100<br>
) RETURNS TABLE(<br>
<span style=3D'mso-spacerun:yes'>    </span>id BIGINT,<br>
<span style=3D'mso-spacerun:yes'>    </span>source_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>target_system TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>event_type TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>payload JSONB,<br>
<span style=3D'mso-spacerun:yes'>    </span>created_at
TIMESTAMPTZ<br>
)<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_last BIGINT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>PERFORM
bus.register_consumer(p_consumer_name);</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>SELECT
last_event_id INTO v_last<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>RETURN
QUERY<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT e.id, e.source_system,
e.target_system, e.event_type, e.payload, e.created_at<br>
<span style=3D'mso-spacerun:yes'>      </span>FROM bus.event_log e<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE e.id &gt; v_last<br>
<span style=3D'mso-spacerun:yes'>       </span>AND (e.target_system =
=3D
p_consumer_name OR e.target_system IS NULL)<br>
<span style=3D'mso-spacerun:yes'>     </span>ORDER BY e.id<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_limit;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>提交 offset：bus.commit_consumer_offset</span=
></p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>只允许前进（=
防止回退）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>可附带锁校验=
（建议），避免“不是锁持有者也能提交
     offset”</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.commit_consumer_offset(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_new_last_id<span
style=3D'mso-spacerun:yes'>   </span>BIGINT<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET last_event_id =3D
GREATEST(last_event_id, p_new_last_id),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D
p_instance_id<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_until &gt;=3D=
 now();</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>释放锁：bus.release_consumer_lock</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.release_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE bus.consumer_registry=
<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_owner =3D NUL=
L,<br>
<span style=3D'mso-spacerun:yes'>           </span>lock_until =3D=
 NULL,<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D p_i=
nstance_id;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.10 清理：两种策略</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:16.0pt'><span
style=3D'font-weight:bold'>A) 清理所有消费者都已消费的数据（=
安全）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.cleanup_consumed(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_batch_size INT DEFAULT 100=
00<br>
) RETURNS INT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_min BIGINT;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_deleted INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT MIN(last_event_id) IN=
TO v_min
FROM bus.consumer_registry;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>IF
v_min IS NULL THEN<br>
<span style=3D'mso-spacerun:yes'>        </span>RETURN 0;<br>
<span style=3D'mso-spacerun:yes'>    </span>END IF;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>DELETE
FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE id &lt; v_min<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_batch_size;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_deleted =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_deleted;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:16.0pt'><span
style=3D'font-weight:bold'>B) 清理一段时间前的数据（比如 7 天=
，可能丢给慢消费者）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.cleanup_older_than(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_older_than INTERVAL,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_batch_size INT DEFAULT 100=
00<br>
) RETURNS INT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_deleted INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>DELETE FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE created_at &lt; now(=
) -
p_older_than<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_batch_size;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_deleted =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_deleted;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>生产建议：</p>

<ul type=3Dcircle style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>定时任务每分=
钟/每5分钟执行一次
     cleanup（循环调用直到返回 0）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>同时使用 A + B=
：A 为主，B
     为兜底（限制表体积）</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>插入重试（指数退避）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.schedule_retry(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_original_id BIGINT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_payload JSONB,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_retry_count INT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_delay INTERVAL;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>-- 指数退避：2^n 秒，=
最大 1 小时<br>
<span style=3D'mso-spacerun:yes'>    </span>v_delay :=3D LEAST(<br>
<span style=3D'mso-spacerun:yes'>        </span>(2 ^ p_retry_count) =
* interval '1
second',<br>
<span style=3D'mso-spacerun:yes'>        </span>interval '1 hour'<br>
<span style=3D'mso-spacerun:yes'>    </span>);<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>INSERT
INTO bus.event_retry(<br>
<span style=3D'mso-spacerun:yes'>        </span>original_id,<br>
<span style=3D'mso-spacerun:yes'>        </span>consumer_name,<br>
<span style=3D'mso-spacerun:yes'>        </span>payload,<br>
<span style=3D'mso-spacerun:yes'>        </span>retry_count,<br>
<span style=3D'mso-spacerun:yes'>        </span>next_retry_at<br>
<span style=3D'mso-spacerun:yes'>    </span>)<br>
<span style=3D'mso-spacerun:yes'>    </span>VALUES (<br>
<span style=3D'mso-spacerun:yes'>        </span>p_original_id,<br>
<span style=3D'mso-spacerun:yes'>        </span>p_consumer_name,<br>
<span style=3D'mso-spacerun:yes'>        </span>p_payload,<br>
<span style=3D'mso-spacerun:yes'>        </span>p_retry_count + 1,<b=
r>
<span style=3D'mso-spacerun:yes'>        </span>now() + v_delay<br>
<span style=3D'mso-spacerun:yes'>    </span>);<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>拉取可重试消息</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.poll_retry(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_limit INT DEFAULT 50<br>
) RETURNS TABLE(<br>
<span style=3D'mso-spacerun:yes'>    </span>retry_id BIGINT,<br>
<span style=3D'mso-spacerun:yes'>    </span>original_id BIGINT,<br>
<span style=3D'mso-spacerun:yes'>    </span>payload JSONB,<br>
<span style=3D'mso-spacerun:yes'>    </span>retry_count INT<br>
)<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN QUERY<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT r.retry_id,<br>
<span style=3D'mso-spacerun:yes'>           </span>r.original_id,=
<br>
<span style=3D'mso-spacerun:yes'>           </span>r.payload,<br>
<span style=3D'mso-spacerun:yes'>           </span>r.retry_count<=
br>
<span style=3D'mso-spacerun:yes'>    </span>FROM bus.event_retry r<br>
<span style=3D'mso-spacerun:yes'>    </span>WHERE r.consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>      </span>AND r.next_retry_at &lt;=
=3D
now()<br>
<span style=3D'mso-spacerun:yes'>    </span>ORDER BY r.next_retry_at<br>
<span style=3D'mso-spacerun:yes'>    </span>LIMIT p_limit<br>
<span style=3D'mso-spacerun:yes'>    </span>FOR UPDATE SKIP
LOCKED;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>删除重试记录（成功后）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.delete_retry(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_retry_id BIGINT<br>
) RETURNS VOID<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>DELETE FROM
bus.event_retry<br>
<span style=3D'mso-spacerun:yes'>    </span>WHERE retry_id =3D
p_retry_id;<br>
END;<br>
$$;</p>

