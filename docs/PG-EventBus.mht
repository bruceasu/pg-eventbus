<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.commit_consumer_offset(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_new_last_id<span
style=3D'mso-spacerun:yes'>   </span>BIGINT<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE
bus.consumer_registry<br>
<span style=3D'mso-spacerun:yes'>       </span>SET last_event_id =3D
GREATEST(last_event_id, p_new_last_id),<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D
p_instance_id<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_until &gt;=3D=
 now();</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.9 释放锁：bus.release_consumer_lock</span>=
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.release_consumer_lock(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_consumer_name TEXT,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_instance_id<span
style=3D'mso-spacerun:yes'>   </span>TEXT<br>
) RETURNS BOOLEAN<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_updated INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>UPDATE bus.consumer_registry=
<br>
<span style=3D'mso-spacerun:yes'>       </span>SET lock_owner =3D NUL=
L,<br>
<span style=3D'mso-spacerun:yes'>           </span>lock_until =3D=
 NULL,<br>
<span style=3D'mso-spacerun:yes'>           </span>updated_at =3D=
 now()<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE consumer_name =3D
p_consumer_name<br>
<span style=3D'mso-spacerun:yes'>       </span>AND lock_owner =3D p_i=
nstance_id;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_updated =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_updated =3D
1;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.10 清理：两种策略</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:16.0pt'><span
style=3D'font-weight:bold'>A) 清理所有消费者都已消费的数据（=
安全）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.cleanup_consumed(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_batch_size INT DEFAULT 100=
00<br>
) RETURNS INT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_min BIGINT;<br>
<span style=3D'mso-spacerun:yes'>    </span>v_deleted INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>SELECT MIN(last_event_id) IN=
TO v_min
FROM bus.consumer_registry;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>IF
v_min IS NULL THEN<br>
<span style=3D'mso-spacerun:yes'>        </span>RETURN 0;<br>
<span style=3D'mso-spacerun:yes'>    </span>END IF;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>DELETE
FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE id &lt; v_min<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_batch_size;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_deleted =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_deleted;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:16.0pt'><span
style=3D'font-weight:bold'>B) 清理一段时间前的数据（比如 7 天=
，可能丢给慢消费者）</span></p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>CREATE
OR REPLACE FUNCTION bus.cleanup_older_than(<br>
<span style=3D'mso-spacerun:yes'>    </span>p_older_than INTERVAL,<br>
<span style=3D'mso-spacerun:yes'>    </span>p_batch_size INT DEFAULT 100=
00<br>
) RETURNS INT<br>
LANGUAGE plpgsql<br>
SECURITY DEFINER<br>
AS $$<br>
DECLARE<br>
<span style=3D'mso-spacerun:yes'>    </span>v_deleted INT;<br>
BEGIN<br>
<span style=3D'mso-spacerun:yes'>    </span>DELETE FROM bus.event_log<br>
<span style=3D'mso-spacerun:yes'>     </span>WHERE created_at &lt; now(=
) -
p_older_than<br>
<span style=3D'mso-spacerun:yes'>     </span>LIMIT p_batch_size;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>GET
DIAGNOSTICS v_deleted =3D ROW_COUNT;<br>
<span style=3D'mso-spacerun:yes'>    </span>RETURN v_deleted;<br>
END;<br>
$$;</p>

<p style=3D'margin:0in;margin-left:.375in;font-family:asu-cjk-code;font-siz=
e:
11.0pt'>生产建议：</p>

<ul type=3Dcircle style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>定时任务每分=
钟/每5分钟执行一次
     cleanup（循环调用直到返回 0）</span></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt'>同时使用 A + B=
：A 为主，B
     为兜底（限制表体积）</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>&nbsp;</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:18.0pt'><span
style=3D'font-weight:bold'>1.11 权限建议（推荐最小授权）</span>=
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>假设：=
</p>

<ul type=3Ddisc style=3D'direction:ltr;unicode-bidi:embed;margin-top:0in;
 margin-bottom:0in'>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt' lang=3Dzh-CN>你�=
�建一个 DB
     role：</span><span style=3D'font-family:asu-cjk-code;font-size:11.0pt'
     lang=3Den-US>bus_owner</span><span style=3D'font-family:asu-cjk-code;
     font-size:11.0pt' lang=3Dzh-CN>（拥有 schema/table/function）</spa=
n></li>
 <li style=3D'margin-top:0;margin-bottom:0;vertical-align:middle'><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt' lang=3Dzh-CN>应�=
�使用 role：</span><span
     style=3D'font-family:asu-cjk-code;font-size:11.0pt' lang=3Den-US>app_r=
ole</span></li>
</ul>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt'>执行思=
路：</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>-- 让
bus_owner 成为 schema/table/function 的 owner（创建时用 bus_owner �=
��行即可）<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>--
收紧表权限：不给应用直接读写<br>
REVOKE ALL ON SCHEMA bus FROM PUBLIC;<br>
REVOKE ALL ON ALL TABLES IN SCHEMA bus FROM PUBLIC;<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>--
允许应用使用 schema（只是命名空间）<br>
GRANT USAGE ON SCHEMA bus TO app_role;<br>
</p>

<p style=3D'margin:0in;font-family:asu-cjk-code;font-size:11.0pt' lang=3Den=
-US>--
只授予函数执行权限（按需列出）<br>
GRANT EXECUTE ON FUNCTION bus.publish_event(TEXT,TEXT,TEXT,JSONB) TO
app_role;<br>
GRANT EXECUTE ON FUNCTION bus.register_consumer(TEXT) TO app_role;<br>
GRANT EXECUTE ON FUNCTION bus.init_consumer_at_time(TEXT,TIMESTAMPTZ) TO ap=
p_role;<br>
GRANT EXECUTE ON FUNCTION bus.acquire_consumer_lock(TEXT,TEXT,INT) TO
app_role;<br>
GRANT EXECUTE ON FUNCTION bus.renew_consumer_lock(TEXT,TEXT,INT) TO
app_role;<br>
